{
  "name": "advanced-stopwatch",
  "version": "0.1.0",
  "description": "Advanced, accessible stopwatch UI component for React",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/advanced-stopwatch.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/advanced-stopwatch/issues"
  },
  "homepage": "https://YOUR_USERNAME.github.io/advanced-stopwatch/",
  "keywords": [
    "react",
    "stopwatch",
    "timer",
    "component",
    "hooks",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:dev": "npm install --prefix demo && npm run dev --prefix demo",
    "demo:build": "npm run build && npm install --prefix demo && npm run build --prefix demo",
    "demo:preview": "npm run preview --prefix demo",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
